# Virtual env & Python cache
venv/
__pycache__/
*.py[cod]

# Model & data
*.h5
!models/best_vgg16_model.h5

*.csv
!logs/prediction_log.csv
!static/logs/vgg16_classification_report.csv

*.json
!logs/prediction_history.json

*.log

# Ignore image files globally, but allow those inside external_test/
*.jpg
*.png
*.jpeg
!external_test/**/*.jpg
!external_test/**/*.png
!external_test/**/*.jpeg

# Exclude logs and outputs except specific ones
logs/*
!logs/prediction_log.csv
!logs/prediction_history.json

static/logs/*
!static/logs/vgg16_classification_report.csv
!static/logs/vgg16_confusion_matrix.png
!static/logs/vgg16_training_plot.png

outputs/*
!outputs/*

reports/*
!reports/** 

# Allow test folders to be tracked
!external_test/
!external_test/melanoma/
!external_test/psoriasis/

# Editor/Jupyter artifacts
.ipynb_checkpoints/
.DS_Store
.env